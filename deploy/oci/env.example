# Copy to /etc/framefuzz/framefuzz.env on the OCI host (mode 600). Never commit real values.

FRAMEFUZZ_ALLOW_PUBLIC_HOST=1
FRAMEFUZZ_BIND=0.0.0.0
FRAMEFUZZ_MODE=LIVE_AUTHORIZED
FRAMEFUZZ_ALLOW_CHAIN=1337
FRAMEFUZZ_CORS_ORIGINS=https://frame-fuzz.vercel.app,https://frame-fuzz-nishanthcr7777s-projects.vercel.app

# EF Frame Tx Alt Mempool (devnet only)
FRAMEFUZZ_RPC=https://altmempool.forshtat.com/rpc
FRAMEFUZZ_PUBLIC_RPC=https://altmempool.forshtat.com
FRAMEFUZZ_ALT_RPC=https://altmempool.forshtat.com/rpc/

# Operator keys — DEVNET ONLY, never mainnet
FRAMEFUZZ_OWNER_KEY=
FRAMEFUZZ_SENDER_KEY=

# Optional agents / Arkiv
OPENROUTER_API_KEY=
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
ARKIV_READER_ADDRESS=
